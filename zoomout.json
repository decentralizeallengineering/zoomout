{
  "test_fail_limit": 3,
  "edit_limit": 5,
  "retry_limit": 3,
  "stall_turns": 25,
  "test_command_patterns": [
    "\\bpytest\\b",
    "python[0-9.]*\\s+-m\\s+(pytest|unittest)\\b",
    "\\b(npm|pnpm|yarn)\\s+(run\\s+)?test\\b",
    "\\bcargo\\s+test\\b",
    "\\bgo\\s+test\\b",
    "\\bmake\\s+(test|check)\\b",
    "\\b(ruff|mypy|tsc|eslint)\\b"
  ],
  "commit_patterns": ["\\bgit\\s+commit\\b"],
  "edit_tools": ["Edit", "Write", "MultiEdit", "NotebookEdit"]
}
